gbm_cl_table_5k <- full_cl_table_5k %>% filter(SimulationModel == "GBM") %>%
select(SimulationModel, r_5k, s2_sv_5k, GBM) %>% rename(TrueProbability = GBM, ClockRate = s2_sv_5k)
iln_cl_table_5k <- full_cl_table_5k %>% filter(SimulationModel == "ILN") %>%
select(SimulationModel, r_5k, s2_sv_5k, ILN) %>% rename(TrueProbability = ILN, ClockRate = s2_sv_5k)
str_cl_table_5k <- full_cl_table_5k %>% filter(SimulationModel == "STR") %>%
select(SimulationModel, r_5k, STR) %>% rename(TrueProbability = STR)
