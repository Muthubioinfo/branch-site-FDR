setwd("/Users/muthukumaranpanchaksaram")
# 0 Load libraries
library(tidyverse)
library(reshape2)
library(ggExtra)
############################################################
###################Kosiol data##############################
setwd("/Users/muthukumaranpanchaksaram/Documents/Proj20/paper/Results/Realdatasimulation/branch lengths variation/blx2")
################################################
#####                Realdata              #####
########################################################################################################
#
#Null model: H0
lnL0 <- as.vector(read.table("rst1null")[[20]])
length(lnL0)
#Alternate model: H1
lnL1A <- as.vector(read.table("rst1alt1")[[21]])
length(lnL1A)
lnL1B <- as.vector(read.table("rst1alt2")[[21]])
length(lnL1B)
lnL1C <- as.vector(read.table("rst1alt3")[[21]])
length(lnL1C)
lnL1 <- pmax(lnL0,lnL1A,lnL1B,lnL1C)
#LRT statistic for simulation under null hypothesis
our_LRT <- cbind(2 * ((lnL1)-(lnL0)))
rownames(our_LRT) <- paste("gene",seq(1:9566),sep = ".")
####################################################################
###To select the gene sets without N alignments//
geneswithoutNalignments <- as.vector(read.table("geneswithoutNalignments.txt"))
gwnas <- as.data.frame(geneswithoutNalignments$V1[order(geneswithoutNalignments$V1)])
colnames(gwnas) <- "V1"
rownames(gwnas) <- paste("gene",gwnas$V1,sep = ".")
#Analysing only the genes without missing species alignment
oLRT <- our_LRT[rownames(gwnas),]
length(oLRT[oLRT > 0]) #LRT greater than 0
length(oLRT[oLRT == 0]) #LRT equal to 0######################
length(oLRT[oLRT < 0]) #LRT less than 0
#Histogram of our_LRT
hist(oLRT[oLRT > 0], n=25, prob=TRUE)
curve(dchisq(x, 1), add=TRUE, col="red", lwd=2)
#P-values
opvalue <- pchisq(oLRT, 1, lower.tail = FALSE)
opmix <- ifelse(opvalue == 1, opvalue == opvalue, opvalue/2)  #Mixture distribution
#length(which(opmix < 0.05)) #Significance of p-values
#length(which(opmix > 0.05))
#Applying FDR control using p-adjust
oq.val <- p.adjust(opvalue, method = "fdr")
length(oq.val)
length(which(oq.val < 0.05))  #Significance after applying FDR
length(which(oq.val > 0.05))
#Total number of PSGs
oP <- sum(oq.val < 0.05) # [1] Total Positives
oP
# Which genes are PSGs
oPSGs <- which(oq.val < 0.05) ###PSGs detected after FDR correction
oPSGs
############Real data simulation###############
##########Selecting the genes for modification################
positivegenelist <- as.vector(read.table("random500genes.txt"))
rownames(positivegenelist) <- paste("gene",positivegenelist$V1,sep=".")
positivegenenumbers <- as.data.frame(positivegenelist$V1[order(positivegenelist$V1)])
colnames(positivegenenumbers) <- "v1"
rownames(positivegenenumbers) <- paste("gene",positivegenenumbers$v1,sep=".")
neutralgenelist <- as.vector(read.table("neutralgenes.txt"))
rownames(neutralgenelist) <- paste("gene",neutralgenelist$V1,sep=".")
neutralgenenumbers <- neutralgenelist$V1[order(neutralgenelist$V1)]
neutralgenes <- as.data.frame(paste("gene",neutralgenenumbers,sep="."))
colnames(neutralgenes) <- "v1"
rownames(neutralgenes) <- neutralgenes$v1
neutralLRT <- as.data.frame(our_LRT[neutralgenes$v1,])
colnames(neutralLRT) <- "v1"
length(neutralLRT[neutralLRT > 0]) #LRT greater than 0
length(neutralLRT[neutralLRT == 0]) #LRT equal to 0######################
length(neutralLRT[neutralLRT < 0]) #LRT less than 0
neutralpval <- pchisq(neutralLRT$v1, 1, lower.tail = FALSE)
#neutralpmix <- ifelse(neutralpval == 1, neutralpval == neutralpval, neutralpval/2)  #Mixture distribution
length(which(neutralpval < 0.05)) #Significance of p-values
length(which(neutralpval > 0.05))
###Removing positivegenelist from neutralLRT
new_neutral_LRT <- as.matrix(neutralLRT[!rownames(neutralLRT) %in% rownames(positivegenenumbers),])
neutgennames <- as.vector(read.table("neugen.txt"))
neugen <- neutgennames$V1[order(neutgennames$V1)]
rownames(new_neutral_LRT) <- paste("gene",neugen,sep=".")
###
modlnL0 <- as.vector(read.table("rst1H1null")[[20]])
length(modlnL0)
modlnL1A <- as.vector(read.table("rst1H1alt1")[[21]])
length(modlnL1A)
modlnL1B <- as.vector(read.table("rst1H1alt2")[[21]])
length(modlnL1B)
modlnL1C <- as.vector(read.table("rst1H1alt3")[[21]])
length(modlnL1C)
modlnL1 <- pmax(modlnL0,modlnL1A,modlnL1B,modlnL1C)
#LRT statistic for simulation under null hypothesis
positive_LRT <- cbind(2 * ((modlnL1)-(modlnL0)))
rownames(positive_LRT) <- rownames(positivegenenumbers)
colnames(positive_LRT) <- "V1"
######Combining positive genes with neutral set to create
###LRTs modified not in order - 1st 6 LRT + 500 LRT
new_LRT <- as.data.frame(rbind(new_neutral_LRT,positive_LRT))
modifiedLRT <- as.data.frame(new_LRT[rownames(neutralLRT),])
rownames(modifiedLRT) <- rownames(neutralLRT)
colnames(modifiedLRT) <- "V1"
length(which(modifiedLRT > 0)) #LRT greater than 0
length(which(modifiedLRT == 0)) #LRT equal to 0######################
length(which(modifiedLRT < 0)) #LRT less than 0
#Histogram of modifiedLRT
hist(modifiedLRT[modifiedLRT > 0], n=25, prob=TRUE)
curve(dchisq(x, 1), add=TRUE, col="red", lwd=2)
#P-values
modifiedpvalue <- pchisq(modifiedLRT$V1, 1, lower.tail = FALSE)
#modifiedpmix <- as.data.frame(ifelse(modifiedpvalue == 1, modifiedpvalue == modifiedpvalue, modifiedpvalue/2))  #Mixture distribution
#colnames(modifiedpmix) <- "V1"
#rownames(modifiedpmix) <- rownames(neutralLRT)
length(which(modifiedpvalue < 0.05)) #Significance of p-values
length(which(modifiedpvalue > 0.05))
#Applying FDR control using p-adjust
modifiedq.val <- cbind(p.adjust(modifiedpvalue, method = "fdr"))
rownames(modifiedq.val) <- rownames(neutralLRT)
length(which(modifiedq.val < 0.05))  #Significance after applying FDR
length(which(modifiedq.val > 0.05))
#Total positive level
modified_totalpositivelevel <- modifiedq.val[rownames(modifiedq.val) %in% rownames(positivegenenumbers), , drop = FALSE] # [1] Total Positives
modified_totalpositivelevel
#Positives
modifiedP <- modifiedq.val[modifiedq.val < 0.05]
length(modifiedP)
#TP
modifiedTP <- modified_totalpositivelevel[modified_totalpositivelevel < 0.05]
length(modifiedTP)
#Modified FP
modifiedFP <- length(modifiedP) - length(modifiedTP)
modifiedFP ##Number of FPs
#Which genes are PSGs
modifiedPSGs <- View(which(modifiedq.val < 0.05,arr.ind=T)) ###PSGs detected after FDR correction
###
pval <- modifiedpvalue
length(pval)
pnull <- neutralpval
length(neutralpval)
######Before modification#####
#############################################################################
##Case 2: When only pvalues < 1 and under chi
#############################################################################
#Checking if it is right or not
row_pval_null <- rownames(neutralgenes)
dat_frame_pval_null <- data.frame(neutralpval,row.names = row_pval_null)
length(dat_frame_pval_null$neutralpval[dat_frame_pval_null$neutralpval < 0.05])
dat_frame_pval_lessthan1_null <- dat_frame_pval_null[ which(dat_frame_pval_null$neutralpval < 1) , ,drop = FALSE]
length(dat_frame_pval_lessthan1_null$neutralpval)
length(dat_frame_pval_lessthan1_null$neutralpval[dat_frame_pval_lessthan1_null$neutralpval < 0.05])
pval_new_null <- dat_frame_pval_lessthan1_null$neutralpval
length(pval_new_null)
hist(pval_new_null)
###By default, pi0est used lambda = seq(0.05,0.95,0.05), and
####c("smoother","bootstrap") chooses the best method among the two methods
pi0_estimate_case2_null <- qvalue::pi0est(pval_new_null, pi0.method = "bootstrap")
plot(pi0_estimate_case2_null$lambda,pi0_estimate_case2_null$pi0.lambda)
###Proportion of true negatives over the P-values < 1 (under chi distribution)
pi0_TN_null <- pi0_estimate_case2_null$pi0
pi0_TN_null
####Total number of P-values: 6903
####The total proportion is 1
pi1_P_null <- 1 - pi0_TN_null
pi1_P_null
pi0_est_total_case2_null <- (length(neutralpval[neutralpval == 1])/6903) + (pi0_TN_null * length(pval_new_null)/6903)
pi0_est_total_case2_null
###
ST_q.val_case2_null <- qvalue::qvalue(neutralpval, fdr.level = 0.05, pfdr = TRUE, pi0 = pi0_est_total_case2_null)
length(ST_q.val_case2_null$qvalues[ST_q.val_case2_null$qvalues < 0.05])
length(ST_q.val_case2_null$qvalues[ST_q.val_case2_null$qvalues > 0.05])
dat_frame_qval_null <- data.frame(ST_q.val_case2_null$qvalues, row.names = row_pval_null)
hist(dat_frame_qval_null$ST_q.val_case2_null.qvalues)
length(dat_frame_qval_null$ST_q.val_case2_null.qvalues)
dat_frame_qval_rej_null <- dat_frame_qval_null[ which(dat_frame_qval_null$ST_q.val_case2_null.qvalues < 0.05), , drop = FALSE ] #Significance after applying FDR
length(dat_frame_qval_rej_null$ST_q.val_case2_null.qvalues)
dat_frame_qval_acpt_null <- dat_frame_qval_null[ which(dat_frame_qval_null$ST_q.val_case2_null.qvalues > 0.05), , drop = FALSE ] #Significance after applying FDR
length(dat_frame_qval_acpt_null$ST_q.val_case2_null.qvalues)
#FDR
ST_P_case2_null <- length(dat_frame_qval_rej_null$ST_q.val_case2_null.qvalues) # [1] Total Positives
ST_P_case2_null
####After Modification#####
#############################################################################
##Case 2: When only pvalues < 1 and under chi
#############################################################################
#Checking if it is right or not
row_pval <- rownames(neutralgenes)
dat_frame_pval <- data.frame(pval,row.names = row_pval)
length(dat_frame_pval$pval[dat_frame_pval$pval < 0.05])
dat_frame_pval_lessthan1 <- dat_frame_pval[ which(dat_frame_pval$pval < 1) , ,drop = FALSE]
length(dat_frame_pval_lessthan1$pval)
length(dat_frame_pval_lessthan1$pval[dat_frame_pval_lessthan1$pval < 0.05])
pval_new <- dat_frame_pval_lessthan1$pval
length(pval_new)
hist(pval_new)
###By default, pi0est used lambda = seq(0.05,0.95,0.05), and
####c("smoother","bootstrap") chooses the best method among the two methods
pi0_estimate_case2 <- qvalue::pi0est(pval_new, pi0.method = "bootstrap")
plot(pi0_estimate_case2$lambda,pi0_estimate_case2$pi0.lambda)
###Proportion of true negatives over the P-values < 1 (under chi distribution)
pi0_TN <- pi0_estimate_case2$pi0
pi0_TN
####Total number of P-values: 6903
####The total proportion is 1
pi1_P <- 1 - pi0_TN
pi1_P
pi0_est_total_case2 <- (length(pval[pval == 1])/6903) + (pi0_TN * length(pval_new)/6903)
pi0_est_total_case2
###
ST_q.val_case2 <- qvalue::qvalue(pval, fdr.level = 0.05, pfdr = TRUE, pi0 = pi0_est_total_case2)
length(ST_q.val_case2$qvalues[ST_q.val_case2$qvalues < 0.05])
length(ST_q.val_case2$qvalues[ST_q.val_case2$qvalues > 0.05])
dat_frame_qval <- data.frame(ST_q.val_case2$qvalues,row.names = row_pval)
hist(dat_frame_qval$ST_q.val_case2.qvalues)
length(dat_frame_qval$ST_q.val_case2.qvalues)
dat_frame_qval_rej <- dat_frame_qval[ which(dat_frame_qval$ST_q.val_case2.qvalues < 0.05), , drop = FALSE ] #Significance after applying FDR
length(dat_frame_qval_rej$ST_q.val_case2.qvalues)
dat_frame_qval_acpt <- dat_frame_qval[ which(dat_frame_qval$ST_q.val_case2.qvalues > 0.05), , drop = FALSE ] #Significance after applying FDR
length(dat_frame_qval_acpt$ST_q.val_case2.qvalues)
#Total qval < 0.05 to compute for normal power
ST_P_case2 <- length(dat_frame_qval_rej$ST_q.val_case2.qvalues) # [1] Total Positives
ST_P_case2
# However, only hypotheses that are randomnly selected (500) are true positives/considered under positive selection, thus:
row_TP_case2 <- rownames(positivegenenumbers)
##Total positive level - 500 gene hypotheses
ST_totalpositivelevel_qval_case2 <- dat_frame_qval[rownames(dat_frame_qval) %in% rownames(positivegenenumbers), ]
ST_totalpositivelevel_pval_case2 <- dat_frame_pval[rownames(dat_frame_pval) %in% rownames(positivegenenumbers), ]
#P-value power among total positive level (500 modified gene hypothesis)
Power <- (length(ST_totalpositivelevel_pval_case2[ST_totalpositivelevel_pval_case2 < 0.05])/500)*100
##True positives observed after apply ST-FDR control
ST_TP_frame_case2 <- dat_frame_qval_rej[rownames(dat_frame_qval_rej) %in% row_TP_case2, , drop = FALSE]
ST_TP_case2 <- length(ST_TP_frame_case2$ST_q.val_case2.qvalues)
ST_TP_case2
#Therefore, there are
ST_FP_case2 <- ST_P_case2 - ST_TP_case2 #False positives
ST_FP_case2
#Proportion of false positives
ST_PFP_case2 <- ST_FP_case2/ST_P_case2  #which is very close to 0.05!
ST_PFP_case2
ST_FDRpower_case2<- (ST_TP_case2/500)*100
ST_FDRpower_case2
hist(ST_q.val_case2)
#####Conclusive results#####
####All hypothesis under null
length(neutralLRT[neutralLRT == 0])
length(neutralpval[neutralpval < 1])
pi0_TN_null
pi1_P_null
pi0_est_total_case2_null
length(ST_q.val_case2_null$pvalues[ST_q.val_case2_null$pvalues < 0.05])
length(ST_q.val_case2_null$qvalues[ST_q.val_case2_null$qvalues < 0.05])
####After Adding positive level (Hyp under alternate hypothesis)
length(which(modifiedLRT == 0))
length(which(modifiedpvalue < 1)) ###modified pvalues and ST_q.val_case2$pvalues are the same
pi0_TN
pi1_P
pi0_est_total_case2
length(ST_q.val_case2$pvalues[ST_q.val_case2$pvalues < 0.05])                     #n(P < 0.05)
length(ST_q.val_case2$qvalues[ST_q.val_case2$qvalues < 0.05])                     #n(q < 0.05)
length(ST_totalpositivelevel_pval_case2[ST_totalpositivelevel_pval_case2 < 0.05]) #n(TP P < 0.05)
length(ST_totalpositivelevel_pval_case2[ST_totalpositivelevel_pval_case2 == 1])   #n(TP P = 1)
ST_TP_case2                                                                       #n(TPaFDR)
ST_PFP_case2*100                                                                  #%FP
Power                                                                             #Power - Pvalue power
ST_FDRpower_case2                                                                 #ST-FDR power
