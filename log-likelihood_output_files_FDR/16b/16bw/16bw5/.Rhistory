library('tidyverse')
####omega is 0.01####
w4x <- c(1,5,10,50,100)
w4y1 <- c(49.17,50.66,52.51,65.30,79.03)
ggplot(mapping=aes(x=w4x, y=w4y1)) +
geom_point(shape=16, color = '#550080', size = 3) +
geom_line(size = 0.8, col= '#550080')  +
theme_bw(base_size = 12) +
theme(panel.grid.major = element_blank(),
panel.grid.minor = element_blank()) +
theme(panel.grid.major.y = element_line(color = "grey")) +
labs(x = expression(paste(italic("% Misspecified genes, (N"[m]^{}*")"))), y = "% LRT = 0") +
theme(axis.text=element_text(size=12), axis.title=element_text(size=20,face="bold")) +
scale_y_continuous(expand = c(0,0)) +
scale_x_continuous(breaks=c(1,5,10,50,100)) +
coord_cartesian(ylim = c(0, 100)) +
theme(text = element_text(family = "Times New Roman"))
