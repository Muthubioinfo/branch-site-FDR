##Coin-flip example
y <- 7 #number of heads
n <- 10 #number of tosses
###Binomial distribution - likelihood null model - H0
binom1 <- function(t,y,n) choose(10,7) * t^y*((1-t)^(n-y))
binom1(t=0.5,y=7,n=10)
dbinom(x=7,size=10,prob=0.5)
###Binomial distribution - likelihood alternate model - H1
binom2 <- function(t,y,n) choose(10,7) * t^y*((1-t)^(n-y))
binom2(t=0.7,y=7,n=10)
dbinom(x=7,size=10,prob=0.7)
LRT <- 2 * (dbinom(x=7,size=10,prob=0.7,log=TRUE) - dbinom(x=7,size=10,prob=0.5,log = TRUE))
pchisq(LRT,df=1,lower.tail = FALSE)
###Another hypothesis - t is unknown can be any value
# between 0 and 1
#bi_norm <- function(t) dbinom(x=7,size=10,prob=t)
#i <- integrate(bi_norm,lower=0,upper=1)
