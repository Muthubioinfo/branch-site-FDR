ln1A <- read.table("rst1H0alt1") #rst1 - lnL1 for 1st iteration
ln1nA <- ln1A[,ncol(ln1A)]
lnL1A <- as.vector(ln1nA) #lnL1 values for 1st iteration
length(lnL1A)
ln1B <- read.table("rst1H0alt2") #rst1 -  lnL1 for 2nd iteration
ln1nB <- ln1B[,ncol(ln1B)]
lnL1B <- as.vector(ln1nB) #lnL1 values for 2nd iteration
length(lnL1B)
ln1C <- read.table("rst1H0alt3") #rst1 - lnL1 for 3rd iteration
ln1nC <- ln1C[,ncol(ln1C)]
lnL1C <-as.vector(ln1nC) #lnL1 values for 3rd iteration
length(lnL1C)
lnL1 <- pmax(lnL0,lnL1A,lnL1B,lnL1C)
#LRT statistic for simulation under null hypothesis
LRTnull <- 2 * ((lnL1)-(lnL0))
length(LRTnull)
hist(LRTnull)
