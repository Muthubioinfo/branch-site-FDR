beta1(t=0.5,a=1,b=1)
#or
dbeta(x=0.5,shape1 = 1,shape2 = 1)
####Plotting density
plot(seq(0,1,0.01),dbeta(seq(0,1,0.01),shape1=1,shape2=1),
ylab = "Uniform prior density")
#H0: t = 0.5; H1: 0 <= t <= 1
###Hypothesis, H0 - assume equal probability of heads and tails
####or P(H)=P(T)=0.5 - Posterior density at t=0.5
beta2 <- function(t,y,n,a,b) t^(y+a-1)*((1-t)^(n-y+b-1)) / beta(y+a, n-y+b)
beta2(t=0.5,y=7,n=10,a=1,b=1)
#or
dbeta(x=0.5,shape1 = 8,shape2 = 4)
posterior_mean_H0 <- (a + y) / (a + b + n)
posterior_mean_H0
###Hypothesis, H1 - assumes t is not fixed  0 <= t <= 1
beta2(t=0.7,y=7,n=10,a=1,b=1)
#or
dbeta(x=0.7,shape1 = 8,shape2 = 4)
posterior_mean_H1 <- (a + y) / (a + b + n)
