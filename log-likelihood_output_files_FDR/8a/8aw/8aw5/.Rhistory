# 3.6 Add max probability and best model columns
full_cl_table_5k <- full_cl_table_5k %>% mutate(MaxProbability = pmax(STR, ILN, GBM)) %>%
mutate(BestModel = apply(.[, 3:5], 1, function(x) names(x)[which.max(x)]))
full_sv_table_5k <- full_sv_table_5k %>% mutate(MaxProbability = pmax(STR, ILN, GBM)) %>%
mutate(BestModel = apply(.[, 3:5], 1, function(x) names(x)[which.max(x)]))
# 3.7 CL, SV and Alpha tables
# 3.7.1 CL tables
gbm_cl_table_5k <- full_cl_table_5k %>% filter(SimulationModel == "GBM") %>%
select(SimulationModel, r_5k, s2_sv_5k, GBM) %>% rename(TrueProbability = GBM, ClockRate = s2_sv_5k)
iln_cl_table_5k <- full_cl_table_5k %>% filter(SimulationModel == "ILN") %>%
select(SimulationModel, r_5k, s2_sv_5k, ILN) %>% rename(TrueProbability = ILN, ClockRate = s2_sv_5k)
str_cl_table_5k <- full_cl_table_5k %>% filter(SimulationModel == "STR") %>%
select(SimulationModel, r_5k, STR) %>% rename(TrueProbability = STR)
# 3.7.2 SV tables
gbm_sv_table_5k <- full_sv_table_5k %>% filter(SimulationModel == "GBM") %>%
select(SimulationModel, r_5k, s2_sv_5k, GBM) %>% rename(TrueProbability = GBM, ClockRate = s2_sv_5k)
iln_sv_table_5k <- full_sv_table_5k %>% filter(SimulationModel == "ILN") %>%
select(SimulationModel, r_5k, s2_sv_5k, ILN) %>% rename(TrueProbability = ILN, ClockRate = s2_sv_5k)
str_sv_table_5k <- full_sv_table_5k %>% filter(SimulationModel == "STR") %>%
select(SimulationModel, r_5k, STR) %>% rename(TrueProbability = STR)
# 3.7.3.1 Rates CV tables
gbm_cl_r_table_5k <- full_cl_table_5k %>% filter(SimulationModel == "GBM") %>%
select(SimulationModel, r_5k, s2_sv_5k, GBM) %>% rename(TrueProbability = GBM)
iln_cl_r_table_5k <- full_cl_table_5k %>% filter(SimulationModel == "ILN") %>%
select(SimulationModel, r_5k, s2_sv_5k, ILN) %>% rename(TrueProbability = ILN)
str_cl_r_table_5k <- full_cl_table_5k %>% filter(SimulationModel == "STR") %>%
select(SimulationModel, r_5k, STR) %>% rename(TrueProbability = STR)
# 3.7.3.2 Rates SV tables
gbm_sv_r_table_5k <- full_sv_table_5k %>% filter(SimulationModel == "GBM") %>%
select(SimulationModel, r_5k, s2_sv_5k, GBM) %>% rename(TrueProbability = GBM)
iln_sv_r_table_5k <- full_sv_table_5k %>% filter(SimulationModel == "ILN") %>%
select(SimulationModel, r_5k, ILN) %>% rename(TrueProbability = ILN)
str_sv_r_table_5k <- full_sv_table_5k %>% filter(SimulationModel == "STR") %>%
select(SimulationModel, r_5k, STR) %>% rename(TrueProbability = STR)
# 3.8 Plots 5k
# 3.8.1 Mean substitution rate
# 3.8.1.1 GBM SV
gbm_sv_r_plot_5k <- ggplot(gbm_sv_r_table_5k, aes(x = r_5k, y = TrueProbability)) + xlim(0, 6.5) + ylim(0, 1) +
geom_point(size = 2, shape = 21, alpha = 0.40, fill = "#4d4d4d") + stat_smooth(method = "loess", se = FALSE, colour = "black", span = 0.5) +
theme_classic() + theme(axis.text.x = element_blank(), axis.ticks.x = element_blank(), plot.title = element_text(hjust = 0.5)) +
labs(x = "", y = "") + geom_hline(yintercept = 0.3333333333333, linetype = "longdash", colour = "black") +
ggtitle("GBM-SV")
# 3.8.1.2 ILN SV
