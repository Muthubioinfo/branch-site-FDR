geom_point(size = 2, shape = 21, alpha = 0.40, fill = "#4d4d4d") + theme_classic() + stat_smooth(method = "loess", se = FALSE, colour = "black") +
theme(panel.grid.major = element_blank(), panel.grid.minor = element_blank(), plot.title = element_text(hjust = 0.5),
plot.margin = unit(c(0, 0, 0, 0), "cm")) +
labs(x = "", y = "") + geom_hline(yintercept = 0.3333333333333, linetype = "longdash", colour = "black") +
ggtitle("GBM-CL")
# 2.8.2.4 ILN-CL
iln_cl_plot_2k <- ggplot(iln_cl_table_2k, aes(x = ClockRate, y = TrueProbability)) + xlim(0, 7.5) + ylim(0, 1) +
geom_point(size = 2, shape = 21, alpha = 0.40, fill = "#4d4d4d") + theme_classic() + stat_smooth(method = "loess", se = FALSE, colour = "black") +
theme(panel.grid.major = element_blank(), panel.grid.minor = element_blank(), plot.title = element_text(hjust = 0.5),
axis.text.y = element_blank(), axis.ticks.y = element_blank(),
plot.margin = unit(c(0, 0, 0, 0), "cm")) +
labs(x = "", y = "") + geom_hline(yintercept = 0.3333333333333, linetype = "longdash", colour = "black") +
ggtitle("ILN-CL")
# 2.8.2.7 Joining plots
first_row <- plot_grid(gbm_sv_plot_2k, iln_sv_plot_2k, ncol = 2, labels = c("A", "B"))
second_row <- plot_grid(gbm_cl_plot_2k, iln_cl_plot_2k, ncol = 2, labels = c("A'", "B'"))
all_plots <- plot_grid(first_row, second_row, ncol = 1)
y.grob <- textGrob("Model probability", gp = gpar(fontsize = 15), rot = 90) # Adicionar legenda do lado
x.grop <- textGrob(expression(paste("Rate drift parameter (", sigma^2, ")", sep = "")), gp = gpar(fontsize = 15))
png("Plots/2k_Scatter_RateDrift.png", height = 6, width = 8, units = 'in', res = 300)
grid.arrange(arrangeGrob(all_plots, left = y.grob, bottom = x.grop))
dev.off()
# 3.1 Load 5k rates and results table
rates_table_5k_1 <- read_tsv("5k/rates_table_5k_L1.tab")
rates_table2_5k_2 <- read_tsv("5k/rates_table_5k_L2.tab")
rates_table2_5k_3 <- read_tsv("5k/rates_table_5k_L3.tab")
rates_table2_5k_4 <- read_tsv("5k/rates_table_5k_L4.tab")
rates_table2_5k_5 <- read_tsv("5k/rates_table_5k_L5.tab")
rates_table_5k <- rates_table_5k_1 %>%
left_join(rates_table2_5k_2, by = c("Simulation_5k_L1" = "Simulation_5k_L2")) %>%
left_join(rates_table2_5k_3, by = c("Simulation_5k_L1" = "Simulation_5k_L3")) %>%
left_join(rates_table2_5k_4, by = c("Simulation_5k_L1" = "Simulation_5k_L4")) %>%
left_join(rates_table2_5k_5, by = c("Simulation_5k_L1" = "Simulation_5k_L5")) %>%
mutate(r_5k = (r_5k_L1 + r_5k_L2 + r_5k_L3 + r_5k_L4 + r_5k_L5)/5,
s2_sv_5k = (s2_sv_5k_L1 + s2_sv_5k_L2 + s2_sv_5k_L3 + s2_sv_5k_L4 + s2_sv_5k_L5)/5,
s2_cl_5k = (s2_cl_5k_L1 + s2_cl_5k_L2 + s2_cl_5k_L3 + s2_cl_5k_L4 + s2_cl_5k_L5)/5) %>%
rename("Simulation_5k" = "Simulation_5k_L1") %>%
select(Simulation_5k, r_5k, s2_sv_5k, s2_cl_5k)
results_table_5k <- read_tsv("5k/5p_gbm_cl_simulation.tab")
# 3.2 Put all results in the same order
results_table_5k <- arrange(results_table_5k, desc(MCMCtree_model_used))
results_table_5k <- arrange(results_table_5k, desc(SimulationModel))
results_table_5k <- arrange(results_table_5k, desc(Simulation_5k))
# 3.3 Clock tables
# 3.3.1 Select clock-like results
cl_table_5k <- results_table_5k %>%
filter(((SimulationModel == "gbm_sv" & MCMCtree_model_used == "gbm_cl") |
(SimulationModel == "gbm_sv" & MCMCtree_model_used == "iln_cl") |
(SimulationModel == "gbm_sv" & MCMCtree_model_used == "str_nn") |
(SimulationModel == "iln_sv" & MCMCtree_model_used == "gbm_cl") |
(SimulationModel == "iln_sv" & MCMCtree_model_used == "iln_cl") |
(SimulationModel == "iln_sv" & MCMCtree_model_used == "str_nn") |
(SimulationModel == "str_nn" & MCMCtree_model_used == "gbm_cl") |
(SimulationModel == "str_nn" & MCMCtree_model_used == "iln_cl") |
(SimulationModel == "str_nn" & MCMCtree_model_used == "str_nn"))) %>%
mutate(SimulationModel = sub("gbm_sv", "GBM", SimulationModel)) %>%
mutate(SimulationModel = sub("iln_sv", "ILN", SimulationModel)) %>%
mutate(SimulationModel = sub("str_nn", "STR", SimulationModel)) %>%
mutate(MCMCtree_model_used = sub("gbm_cl", "GBM", MCMCtree_model_used)) %>%
mutate(MCMCtree_model_used = sub("iln_cl", "ILN", MCMCtree_model_used)) %>%
mutate(MCMCtree_model_used = sub("str_nn", "STR", MCMCtree_model_used))
# 3.3.2 Select seriously-violated clock table
sv_table_5k <- results_table_5k %>%
filter(((SimulationModel == "gbm_sv" & MCMCtree_model_used == "gbm_sv") |
(SimulationModel == "gbm_sv" & MCMCtree_model_used == "iln_sv") |
(SimulationModel == "gbm_sv" & MCMCtree_model_used == "str_nn") |
(SimulationModel == "iln_sv" & MCMCtree_model_used == "gbm_sv") |
(SimulationModel == "iln_sv" & MCMCtree_model_used == "iln_sv") |
(SimulationModel == "iln_sv" & MCMCtree_model_used == "str_nn") |
(SimulationModel == "str_nn" & MCMCtree_model_used == "gbm_sv") |
(SimulationModel == "str_nn" & MCMCtree_model_used == "iln_sv") |
(SimulationModel == "str_nn" & MCMCtree_model_used == "str_nn"))) %>%
mutate(SimulationModel = sub("gbm_sv", "GBM", SimulationModel)) %>%
mutate(SimulationModel = sub("iln_sv", "ILN", SimulationModel)) %>%
mutate(SimulationModel = sub("str_nn", "STR", SimulationModel)) %>%
mutate(MCMCtree_model_used = sub("gbm_sv", "GBM", MCMCtree_model_used)) %>%
mutate(MCMCtree_model_used = sub("iln_sv", "ILN", MCMCtree_model_used)) %>%
mutate(MCMCtree_model_used = sub("str_nn", "STR", MCMCtree_model_used))
# 3.4 Perform Bayes Factor for each simulation and store result in a new data frame
prob_cl_table_5k <- tibble(SimulationModel = character(), Simulation_5k = double(), STR = double(),
ILN = double(), GBM = double(), Clock = character())
prob_sv_table_5k <- tibble(SimulationModel = character(), Simulation_5k = double(), STR = double(),
ILN = double(), GBM = double(), Clock = character())
# 3.4.1 Clock-like model
for (i in c("STR", "GBM", "ILN")) {
for (j in 1:250) {
temp_table <- cl_table_5k %>%
filter(SimulationModel == i & Simulation_5k == j)
BayesFactors <- exp(temp_table$Logml - max(temp_table$Logml))
Prob <- BayesFactors / sum(BayesFactors)
prob_cl_table_5k <- prob_cl_table_5k %>%
add_row(SimulationModel = i, Simulation_5k = j, STR = Prob[1],
ILN = Prob[2], GBM = Prob[3], Clock = "Clock-like")
}
}
# 3.4.2 Seriously-violated clock model
for (i in c("STR", "GBM", "ILN")) {
for (j in 1:250) {
temp_table <- sv_table_5k %>%
filter(SimulationModel == i & Simulation_5k == j)
BayesFactors <- exp(temp_table$Logml - max(temp_table$Logml))
Prob <- BayesFactors / sum(BayesFactors)
prob_sv_table_5k <- prob_sv_table_5k %>%
add_row(SimulationModel = i, Simulation_5k = j, STR = Prob[1],
ILN = Prob[2], GBM = Prob[3], Clock = "Seriously-violated")
}
}
# 3.5 Rates and results table together
full_cl_table_5k <- prob_cl_table_5k %>% full_join(rates_table_5k, by = "Simulation_5k")
full_sv_table_5k <- prob_sv_table_5k %>% full_join(rates_table_5k, by = "Simulation_5k")
# 3.6 Add max probability and best model columns
full_cl_table_5k <- full_cl_table_5k %>% mutate(MaxProbability = pmax(STR, ILN, GBM)) %>%
mutate(BestModel = apply(.[, 3:5], 1, function(x) names(x)[which.max(x)]))
full_sv_table_5k <- full_sv_table_5k %>% mutate(MaxProbability = pmax(STR, ILN, GBM)) %>%
mutate(BestModel = apply(.[, 3:5], 1, function(x) names(x)[which.max(x)]))
