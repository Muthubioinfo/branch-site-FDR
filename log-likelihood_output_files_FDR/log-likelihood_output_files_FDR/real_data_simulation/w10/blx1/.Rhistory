#FDR
ST_P_case2_null <- length(dat_frame_qval_rej_null$ST_q.val_case2_null.qvalues) # [1] Total Positives
ST_P_case2_null
####After Modification#####
#############################################################################
##Case 2: When only pvalues < 1 and under chi
#############################################################################
#Checking if it is right or not
row_pval <- rownames(neutralgenes)
dat_frame_pval <- data.frame(pval,row.names = row_pval)
length(dat_frame_pval$pval[dat_frame_pval$pval < 0.05])
dat_frame_pval_lessthan1 <- dat_frame_pval[ which(dat_frame_pval$pval < 1) , ,drop = FALSE]
length(dat_frame_pval_lessthan1$pval)
length(dat_frame_pval_lessthan1$pval[dat_frame_pval_lessthan1$pval < 0.05])
pval_new <- dat_frame_pval_lessthan1$pval
length(pval_new)
hist(pval_new)
###By default, pi0est used lambda = seq(0.05,0.95,0.05), and
####c("smoother","bootstrap") chooses the best method among the two methods
pi0_estimate_case2 <- qvalue::pi0est(pval_new, pi0.method = "bootstrap")
plot(pi0_estimate_case2$lambda,pi0_estimate_case2$pi0.lambda)
###Proportion of true negatives over the P-values < 1 (under chi distribution)
pi0_TN <- pi0_estimate_case2$pi0
pi0_TN
####Total number of P-values: 6903
####The total proportion is 1
pi1_P <- 1 - pi0_TN
pi1_P
pi0_est_total_case2 <- (length(pval[pval == 1])/6903) + (pi0_TN * length(pval_new)/6903)
pi0_est_total_case2
###
ST_q.val_case2 <- qvalue::qvalue(pval, fdr.level = 0.05, pfdr = TRUE, pi0 = pi0_est_total_case2)
length(ST_q.val_case2$qvalues[ST_q.val_case2$qvalues < 0.05])
length(ST_q.val_case2$qvalues[ST_q.val_case2$qvalues > 0.05])
dat_frame_qval <- data.frame(ST_q.val_case2$qvalues,row.names = row_pval)
hist(dat_frame_qval$ST_q.val_case2.qvalues)
length(dat_frame_qval$ST_q.val_case2.qvalues)
dat_frame_qval_rej <- dat_frame_qval[ which(dat_frame_qval$ST_q.val_case2.qvalues < 0.05), , drop = FALSE ] #Significance after applying FDR
length(dat_frame_qval_rej$ST_q.val_case2.qvalues)
dat_frame_qval_acpt <- dat_frame_qval[ which(dat_frame_qval$ST_q.val_case2.qvalues > 0.05), , drop = FALSE ] #Significance after applying FDR
length(dat_frame_qval_acpt$ST_q.val_case2.qvalues)
#Total qval < 0.05 to compute for normal power
ST_P_case2 <- length(dat_frame_qval_rej$ST_q.val_case2.qvalues) # [1] Total Positives
ST_P_case2
# However, only hypotheses that are randomnly selected (500) are true positives/considered under positive selection, thus:
row_TP_case2 <- rownames(positivegenenumbers)
##Total positive level - 500 gene hypotheses
ST_totalpositivelevel_qval_case2 <- dat_frame_qval[rownames(dat_frame_qval) %in% rownames(positivegenenumbers), ]
ST_totalpositivelevel_pval_case2 <- dat_frame_pval[rownames(dat_frame_pval) %in% rownames(positivegenenumbers), ]
#P-value power among total positive level (500 modified gene hypothesis)
Power <- (length(ST_totalpositivelevel_pval_case2[ST_totalpositivelevel_pval_case2 < 0.05])/500)*100
##True positives observed after apply ST-FDR control
ST_TP_frame_case2 <- dat_frame_qval_rej[rownames(dat_frame_qval_rej) %in% row_TP_case2, , drop = FALSE]
ST_TP_case2 <- length(ST_TP_frame_case2$ST_q.val_case2.qvalues)
ST_TP_case2
#Therefore, there are
ST_FP_case2 <- ST_P_case2 - ST_TP_case2 #False positives
ST_FP_case2
#Proportion of false positives
ST_PFP_case2 <- ST_FP_case2/ST_P_case2  #which is very close to 0.05!
ST_PFP_case2
ST_FDRpower_case2<- (ST_TP_case2/500)*100
ST_FDRpower_case2
hist(ST_q.val_case2)
#####Conclusive results#####
####All hypothesis under null
length(neutralLRT[neutralLRT == 0])
length(neutralpval[neutralpval < 1])
pi0_TN_null
pi1_P_null
pi0_est_total_case2_null
length(ST_q.val_case2_null$pvalues[ST_q.val_case2_null$pvalues < 0.05])
length(ST_q.val_case2_null$qvalues[ST_q.val_case2_null$qvalues < 0.05])
####After Adding positive level (Hyp under alternate hypothesis)
length(which(modifiedLRT == 0))
length(which(modifiedpvalue < 1)) ###modified pvalues and ST_q.val_case2$pvalues are the same
pi0_TN
pi1_P
pi0_est_total_case2
length(ST_q.val_case2$pvalues[ST_q.val_case2$pvalues < 0.05])                     #n(P < 0.05)
length(ST_q.val_case2$qvalues[ST_q.val_case2$qvalues < 0.05])                     #n(q < 0.05)
length(ST_totalpositivelevel_pval_case2[ST_totalpositivelevel_pval_case2 < 0.05]) #n(TP P < 0.05)
length(ST_totalpositivelevel_pval_case2[ST_totalpositivelevel_pval_case2 == 1])   #n(TP P = 1)
ST_TP_case2                                                                       #n(TPaFDR)
ST_PFP_case2*100                                                                  #%FP
Power                                                                             #Power - Pvalue power
ST_FDRpower_case2                                                                 #ST-FDR power
