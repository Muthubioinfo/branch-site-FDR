geom_point(shape=0,fill="black",mapping = aes(x=lcbx, y=lcby3), col = '#000000', size = 3) +
geom_line(mapping = aes(x=lcbx, y=lcby3),size = 0.8, col= '#000000',linetype="dashed") +
theme_bw(base_size = 12) +
theme(panel.grid.major = element_blank(),
panel.grid.minor = element_blank()) +
theme(panel.grid.major.y = element_line(color = "grey")) +
labs(x = expression(paste(italic("L"))[c]^{}*""), y = "Power (%)") +
theme(axis.text=element_text(size=12), axis.title=element_text(size=28,face="bold")) +
theme(axis.text=element_text(size=12), axis.title=element_text(size=28,face="bold")) +
scale_y_continuous(expand = c(0,0)) +
scale_x_continuous(breaks=c(2000,4000,6000,8000,10000)) +
coord_cartesian(ylim = c(0, 110)) +
theme(text = element_text(family = "Times New Roman")) +
theme(axis.text.x = element_text(size = 20)) +
theme(axis.text.y = element_text(size = 20))
