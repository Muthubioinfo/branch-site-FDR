###Proportion of true negatives over the P-values < 1 (under chi distribution)
pi0_TN <- pi0_estimate_case2$pi0
pi0_TN
####Total number of P-values: 10000
####The total proportion is 1
pi1_P <- 1 - pi0_TN
pi1_P
pi0_est_total_case2 <- ((10000 - length(pval[pval < 1]))/10000) + (pi0_TN * length(pval_new)/10000)
pi0_est_total_case2
###ST_q.val_case2 <- qvalue::qvalue(pval, fdr.level = 0.05, pi0 = pi0_est_total_case2)
ST_q.val_case2 <- qvalue::qvalue(pval, fdr.level = 0.05, pfdr = TRUE, pi0 = pi0_est_total_case2)
length(ST_q.val_case2$qvalues[ST_q.val_case2$qvalues < 0.05])
length(ST_q.val_case2$qvalues[ST_q.val_case2$qvalues > 0.05])
dat_frame_qval <- data.frame(ST_q.val_case2$qvalues,row.names = row_pval)
hist(dat_frame_qval$ST_q.val_case2.qvalues)
length(dat_frame_qval$ST_q.val_case2.qvalues)
dat_frame_qval_rej <- dat_frame_qval[ which(dat_frame_qval$ST_q.val_case2.qvalues < 0.05), , drop = FALSE ] #Significance after applying FDR
length(dat_frame_qval_rej$ST_q.val_case2.qvalues)
dat_frame_qval_acpt <- dat_frame_qval[ which(dat_frame_qval$ST_q.val_case2.qvalues > 0.05), , drop = FALSE ] #Significance after applying FDR
length(dat_frame_qval_acpt$ST_q.val_case2.qvalues)
#FDR
ST_P_case2 <- length(dat_frame_qval_rej$ST_q.val_case2.qvalues) # [1] Total Positives
ST_P_case2
# However, only simulations 1 to 1,000 are true positives/considered under positive selection, thus:
row_TP_case2 <- paste("g",c(1:z))
ST_TP_frame_case2 <- dat_frame_qval_rej[rownames(dat_frame_qval_rej) %in% row_TP_case2, , drop = FALSE]
ST_TP_case2 <- length(ST_TP_frame_case2$ST_q.val_case2.qvalues)
ST_TP_case2
# Therefore, there are
ST_FP_case2 <- ST_P_case2 - ST_TP_case2 #False positives
ST_FP_case2
#Proportion of false positives
ST_PFP_case2 <- ST_FP_case2/ST_P_case2  #which is very close to 0.05!
ST_PFP_case2
ST_FDRpower_case2<- (ST_TP_case2/z)*100
ST_FDRpower_case2
hist(ST_q.val_case2)
####All 10,000 hypothesis under null
length(which(pnull < 1))
pi0_TN_null
pi1_P_null
pi0_est_total_case2_null
length(ST_q.val_case2_null$pvalues[ST_q.val_case2_null$pvalues < 0.05])
length(ST_q.val_case2_null$qvalues[ST_q.val_case2_null$qvalues < 0.05])
ST_TP_case2_null
ST_PFP_case2_null
ST_FDRpower_case2_null
####10,000 hypotheses with 10% positive level (1,000 hyp under alternate hypothesis)
length(which(pval < 1))
pi0_TN
pi1_P
pi0_est_total_case2
length(ST_q.val_case2$pvalues[ST_q.val_case2$pvalues < 0.05])
print(sum(which(ST_q.val_case2$pvalues < 0.05) <= z))
print(sum(which(ST_q.val_case2$pvalues == 1) <= z))
length(ST_q.val_case2$qvalues[ST_q.val_case2$qvalues < 0.05])
ST_TP_case2
ST_PFP_case2*100
ST_FDRpower_case2
#Plots and diagrams
rm(list=ls())
library('tidyverse')
####omega-alpha####
wax <- c(1.5, 2, 3, 5, 8, 10)
way1 <- c(12.4,24.4,56.3,91.3,99.1,99.5)
way2 <- c(0,0,10.9,66,93.5,97.1)
way3 <- c(0,0,2.9,59,91.9,96.7)
ggplot(mapping=aes(x=wax, y=way1)) +
geom_point(shape=1,color = '#000000', size = 3) +
geom_line(size = 0.8, col= '#000000')  +
geom_point(shape=16, fill = "black",mapping = aes(x=wax, y=way2), col = '#000000', size = 3) +
geom_line(mapping = aes(x=wax, y=way2),size = 0.8, col= '#000000') +
theme_bw(base_size = 12) +
geom_point(shape=0, fill = "black",mapping = aes(x=wax, y=way3), col = '#000000', size = 3) +
geom_line(mapping = aes(x=wax, y=way3),size = 0.8, col= '#000000',linetype="dashed") +
theme_bw(base_size = 12) +
theme(panel.grid.major = element_blank(),
panel.grid.minor = element_blank()) +
theme(panel.grid.major.y = element_line(color = "grey")) +
labs(x = expression(omega [2]^{}*""), y = "Power (%)") +
theme(axis.text=element_text(size=12), axis.title=element_text(size=28,face="bold")) +
theme(axis.text=element_text(size=12), axis.title=element_text(size=28,face="bold")) +
scale_y_continuous(expand = c(0,0)) +
scale_x_continuous(breaks=c(2,4,6,8,10)) +
coord_cartesian(ylim = c(0, 110)) +
theme(text = element_text(family = "Times New Roman")) +
theme(axis.text.x = element_text(size = 20)) +
theme(axis.text.y = element_text(size = 20))
