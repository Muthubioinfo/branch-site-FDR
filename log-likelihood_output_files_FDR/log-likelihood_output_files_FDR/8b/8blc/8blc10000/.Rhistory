length(lnaL0)
#Alternate model: H1
lna1A <- read.table("rst1H1alt1") #rst1 - lnL1 for 1st iteration
lna1nA <- lna1A[[25]]
lnaL1A <- as.vector(lna1nA) #lnL1 values for 1st iteration
length(lnaL1A)
lna1B <- read.table("rst1H1alt2") #rst1 -  lnL1 for 2nd iteration
lna1nB <- lna1B[[25]]
lnaL1B <- as.vector(lna1nB) #lnL1 values for 2nd iteration
length(lnaL1B)
lna1C <- read.table("rst1H1alt3") #rst1 - lnL1 for 3rd iteration
lna1nC <- lna1C[[25]]
lnaL1C <-as.vector(lna1nC) #lnL1 values for 3rd iteration
length(lnaL1C)
lnaL1 <- pmax(lnaL0,lnaL1A,lnaL1B,lnaL1C)
#LRT statistic for simulation under alternate hypothesis
LRTalt <- 2 * ((lnaL1)-(lnaL0))
length(LRTalt)
hist(LRTalt)
LRTaltp<- LRTalt[LRTalt > 0] #LRT greater than 0
length(LRTaltp)
LRTalt0<- LRTalt[LRTalt == 0] #LRT equal to 0
length(LRTalt0)
LRTaltn <- LRTalt[LRTalt < 0] #LRT less than 0
length(LRTaltn)
#Histogram LRTalt
hist(LRTalt[LRTalt > 0], n=25, prob=TRUE)
#P-values for simulations under alternate hypothesis
palt <- pchisq(LRTalt, 1, lower.tail = FALSE)
pmixalt <- ifelse(palt == 1, palt == palt, palt/2)  #Mixture distribution
length(psalt <- pmixalt[pmixalt < 0.05])
length(psaltn <- pmixalt[pmixalt > 0.05])
#Applying FDR control using p-adjust for simulations under null hyp
qalt <- p.adjust(palt, method = "fdr")
length(qalt)
length(qaltp <- qalt[qalt < 0.05])
length(qaltn <- qalt[qalt > 0.05])
####################################################################################################
#Combining the first 1000 replicates simulated under alternate hypothesis with the subsequent 9000
#simulated under null hypothesis####################################################################
#Removing the first 1000 replicates from the vector LRTnull to get LRT9000
LRT9000 <- LRTnull[-(1:1000)] #LRTnull is the LRT vector simulated for 10000 simulations under null
all.equal(LRTnull[1001:10000], LRT9000) #To verify the new vector
#Adding the 1000 replicates from LRTalt combining to new LRT
LRT <- c(LRTalt, LRT9000) #LRTalt is the LRT calculated for 1000 simulations under alternate hyp
all.equal(LRT[1:1000], LRTalt) #To verify the new LRT
length(LRT[LRT > 0])
length(LRT[LRT == 0])
#Histogram of new LRT
hist(LRT, n=30, prob=TRUE, col="white",main=paste("Histogram of LRT"),xlab="LRT")
curve(dchisq(x, 1), add=TRUE, col="#00B050", lwd=2)
#P-values combined
pval <- pchisq(LRT, 1, lower.tail = FALSE)
pmix <- ifelse(pval == 1, pval == pval, pval/2)  #Mixture distribution
#Histogram of new LRT
hist(pmix, col="white",main=paste("Histogram of P-values"),xlab="P-values",ylab="Probability",ylim=c(0,5000))
length(psig <- pmix[which(pmix < 0.05)]) #Significance of p-values
length(psign <- pmix[which(pmix > 0.05)])
#Applying FDR control using p-adjust
q.val <- p.adjust(pval, method = "fdr")
length(q.val)
length(q.valp <- q.val[q.val < 0.05])  #Significance after applying FDR
length(q.valn <- q.val[q.val > 0.05])
#FDR
P <- length(which(q.val < 0.05)) # [1] Total Positives
P
# However, only simulations 1 to 1,000 are true positives/considered under positive selection, thus:
which(q.val < 0.05)
TP <- sum(which(q.val < 0.05) <= 1e3) # [1] True positives identified after FDR
TP
# Therefore, there are
FP <- P - TP #False positives
FP
#Proportion of false positives
PFP <- FP/P  #which is very close to 0.05!
PFP
FDRpower<- (TP/1000)*100
FDRpower
#
###Compiled results###
###Under null####
length(LRTnull[LRTnull == 0])                 ###LRT=0###
length(psnull <- pmixnull[pmixnull < 0.025])  ### n (p < 0.025) ###
length(psnull <- pmixnull[pmixnull < 0.05])   ### n (p < 0.05) ###
length(qnullp <- qnull[qnull < 0.05])         ### n (q < 0.05) ###
###Null and alternate###
length(LRT[LRT == 0])                 ### LRT=0 ###
length(psig <- pmix[pmix < 0.025])    ### n (p < 0.025) ###
length(psig <- pmix[pmix < 0.05])     ### n (p < 0.05) ###
length(q.valp <- q.val[q.val < 0.05]) ### n (q < 0.05) ###
print(sum(which(pmix < 0.05) <= 1e3)) ### n (TP p < 0.05) ###
TP                                    ### n(TPaFDR) ###
PFP*100                               ### %FP ###
FDRpower                              ### FDR power ###
####STOREY FDR####
library(qvalue)
##################################################
#pnull
row_pnull <- paste("g",c(1:10000))
dat_frame_pnull <- data.frame(pnull,row.names = row_pnull)
length(dat_frame_pnull$pnull)
length(dat_frame_pnull$pnull[dat_frame_pnull$pnull < 0.05])
dat_frame_pnull_lessthan1 <- dat_frame_pnull[ which(dat_frame_pnull$pnull < 1) , ,drop = FALSE]
length(dat_frame_pnull_lessthan1$pnull)
length(dat_frame_pnull_lessthan1$pnull[dat_frame_pnull_lessthan1$pnull < 0.05])
pnull_new_null <- dat_frame_pnull_lessthan1$pnull
length(pnull_new_null)
hist(pnull_new_null)
###By default, the pi0est uses lambda interval {0.05, 0.95} at step length of 0.05
pi0_estimate_case2_null <- qvalue::pi0est(pnull_new_null, pi0.method = "bootstrap")
###Proportion of true negatives over the P-values < 1 (under chi distribution)
pi0_TN_null <- pi0_estimate_case2_null$pi0
pi0_TN_null
####Total number of P-values: 10000
####The total proportion is 1
pi1_P_null <- 1 - pi0_TN_null
pi1_P_null
pi0_est_total_case2_null <- ((10000 - length(pnull[pnull < 1]))/10000 + (pi0_TN_null * length(pnull_new_null))/10000)
pi0_est_total_case2_null
#By default lfdr.out = TRUE
ST_q.val_case2_null <- qvalue::qvalue(pnull, fdr.level = 0.05, pfdr = TRUE, pi0 = pi0_est_total_case2_null)
length(ST_q.val_case2_null$qvalues[ST_q.val_case2_null$qvalues < 0.05])
length(ST_q.val_case2_null$qvalues[ST_q.val_case2_null$qvalues > 0.05])
dat_frame_qval_null <- data.frame(ST_q.val_case2_null$qvalues,row.names = row_pnull)
hist(dat_frame_qval_null$ST_q.val_case2_null.qvalues)
length(dat_frame_qval_null$ST_q.val_case2_null.qvalues)
dat_frame_qval_rej_null <- dat_frame_qval_null[ which(dat_frame_qval_null$ST_q.val_case2_null.qvalues < 0.05), , drop = FALSE ] #Significance after applying FDR
length(dat_frame_qval_rej_null$ST_q.val_case2_null.qvalues)
dat_frame_qval_acpt_null <- dat_frame_qval_null[ which(dat_frame_qval_null$ST_q.val_case2_null.qvalues > 0.05), , drop = FALSE ] #Significance after applying FDR
length(dat_frame_qval_acpt_null$ST_q.val_case2_null.qvalues)
#FDR
ST_P_case2_null <- length(dat_frame_qval_rej_null$ST_q.val_case2_null.qvalues) # [1] Total Positives
ST_P_case2_null
# However, only simulations 1 to 1,000 are true positives/considered under positive selection, thus:
row_TP_case2_null <- paste("g",c(1:1000))
ST_TP_frame_case2_null <- dat_frame_qval_rej_null[rownames(dat_frame_qval_rej_null) %in% row_TP_case2_null, , drop = FALSE]
ST_TP_case2_null <- length(ST_TP_frame_case2_null$ST_q.val_case2_null.qvalues)
ST_TP_case2_null
# Therefore, there are
ST_FP_case2_null <- ST_P_case2_null - ST_TP_case2_null #False positives
ST_FP_case2_null
#Proportion of false positives
ST_PFP_case2_null <- ST_FP_case2_null/ST_P_case2_null  #which is very close to 0.05!
ST_PFP_case2_null
ST_FDRpower_case2_null<- (ST_TP_case2_null/1000)*100
ST_FDRpower_case2_null
hist(ST_q.val_case2_null)
#############################################################################
