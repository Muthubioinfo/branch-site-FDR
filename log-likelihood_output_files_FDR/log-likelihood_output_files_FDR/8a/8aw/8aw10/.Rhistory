#Simulating 10000 replicates under null hypothesis
#rm(list=ls())
setwd("/Users/muthukumaranpanchaksaram/Documents/Proj20/paper/Results/Simresults/8sp/8a/8aw/8aw10")
library('qvalue')
#Loading rst1 file from iteration 1
#Iteration 1 - Null model (H0)
#Initial_omega=1 fix_omega = 1
ln0 <- read.table("rst1H0null")[,ncol(read.table("rst1H0null"))] #rst1 - lnL0 values
#Loading rst1 file from iteration 2
#Alternate model: H1
#estimate_omega=0 fix_omega = 1
ln1A <- read.table("rst1H0alt1")[,ncol(read.table("rst1H0alt1"))] #rst1 - lnL1 for 1st iteration
#Loading rst1 file from iteration 3
#Alternate model: H1
#estimate_omega=0 fix_omega = 2
ln1B <- read.table("rst1H0alt2")[,ncol(read.table("rst1H0alt2"))]
#Loading rst1 file from iteration 4
#Alternate model: H1
#estimate_omega=0 fix_omega = 4
ln1C <- read.table("rst1H0alt3")[,ncol(read.table("rst1H0alt3"))]
##Simulations under alternate hypothesis
lna0 <- read.table("rst1H1null")[,ncol(read.table("rst1H1null"))]
lna1A <- read.table("rst1H1alt1")[,ncol(read.table("rst1H1alt1"))]  #rst1 - lnL1 for 1st iteration
lna1B <- read.table("rst1H1alt2")[,ncol(read.table("rst1H1alt2"))] #rst1 -  lnL1 for 2nd iteration
lna1C <- read.table("rst1H1alt3")[,ncol(read.table("rst1H1alt3"))] #rst1 - lnL1 for 3rd iteration
#z represents the number of simulations under alternative  hypothesis
#z changes depending on the number of alternative hypothesis considered in the simulations
#FDR <- function(ln0,ln1A,ln1B,ln1C,lna0,lna1A,lna1B,lna1C)
lnL0 <- ln0
lnL1 <- pmax(ln0,ln1A,ln1B,ln1C)
#LRT statistic for simulation under null hypothesis
LRTnull <- 2 * ((lnL1)-(lnL0))
length(LRTnull)
hist(LRTnull)
##Simulations under alternative hypothesis
lnaL0 <- lna0
lnaL1 <- pmax(lna0,lna1A,lna1B,lna1C)
#LRT statistic for simulation under alternative hypothesis
LRTalt <- 2 * ((lnaL1)-(lnaL0))
length(LRTalt)
hist(LRTalt)
####################################################################################################
#Combining the first 1000 replicates simulated under alternative hypothesis with the subsequent 9000
#simulated under null hypothesis####################################################################
###Set the number of alternative hypothesis
z <- length(LRTalt)
#Removing the first 1000 replicates from the vector LRTnull to get LRT_null
LRT_null <- LRTnull[-(1:z)] #LRTnull is the LRT vector simulated for 10000 simulations under null
#Adding the 1000 replicates from LRTalt combining to new LRT
LRT <- c(LRTalt[1:z], LRT_null) #LRTalt is the LRT calculated for 1000 simulations under alternate hyp
length(LRT[LRT > 0])
length(LRT[LRT == 0])
#Histogram of new LRT
hist(LRT, n=30, prob=TRUE, col="white",main=paste("Histogram of LRT"),xlab="LRT")
curve(dchisq(x, 1), add=TRUE, col="#00B050", lwd=2)
#P-values combined
pval <- pchisq(LRT, 1, lower.tail = FALSE)
#Creating a data frame of all P-values
row_pval <- paste("g",c(1:10000))
pval <- data.frame(pval, row.names = row_pval)$pval
length(pval[pval < 0.05]) #P-value significant
#Dividing P-values by 2 under the mixture distribution
p_halved <- ifelse(pval == 1, pval == pval, pval/2)  #Mixture distribution
#Histogram of new LRT
hist(p_halved, col="white",main=paste("Histogram of P-values"),xlab="P-values",ylab="Probability",ylim=c(0,5000), cex=2.5)
BH.psig <- which(p_halved < 0.05)
length(psig <- p_halved[which(p_halved < 0.05)]) #Significance of p-values
#######################################################
#CASE (1): BENJAMINI-HOCHBERG PROCEDURE
#Applying FDR control using p-adjust
BH.q.val <- qvalue::qvalue(p=p_halved)$qvalues
length(BH.q.val)
length(BH.q.val[BH.q.val < 0.05])  #Significance after applying FDR
length(BH.q.val[BH.q.val > 0.05])
hist(BH.q.valn, col="white",main=paste("Histogram of P-values"),xlab="P-values",ylab="Probability",ylim=c(0,5000), cex=2.5)
hist(BH.q.val, col="white",main=paste("Histogram of P-values"),xlab="P-values",ylab="Probability",ylim=c(0,5000), cex=2.5)
# Total Positives
BH.P <- length(which(q.val < 0.05))
# However, only simulations 1 to 1,000 are true positives/considered under positive selection, thus:
which(q.val < 0.05)
BH.TP <- sum(which(q.val < 0.05) <= z) # [1] True positives identified after FDR
# Total Positives
BH.P <- length(which(BH.q.val < 0.05))
# However, only simulations 1 to 1,000 are true positives/considered under positive selection, thus:
which(BH.q.val < 0.05)
BH.TP <- sum(which(BH.q.val < 0.05) <= z) # [1] True positives identified after FDR
# Therefore, there are
BH.FP <- BH.P - BH.TP #False positives
#Proportion of false positives
BH.PFP <- BH.FP/BH.P  #which is very close to 0.05!
#CLASSICAL POWER
Power <- (print(sum(which(p_halved < 0.05) <= z))/z)*100
#FDR POWER
BH.FDRpower<- (BH.TP/z)*100
###Results after adjusting for BH-FDR ###
neutral_LRTs <- length(LRT[LRT == 0])                 ### LRT=0 ###
BH.signif_P <- length(psig <- p_halved[p_halved < 0.05])     ### n (p < 0.05) ###
BH.signif_q <- length(q.valp <- q.val[q.val < 0.05]) ### n (q < 0.05) ###
#True positive P-values - n (TP p < 0.05)
BH.true_positive_pval_signif <- print(sum(which(p_halved < 0.05) <= z))
BH.true_positive_pval_1 <- print(sum(which(p_halved == 1) <= z))     ### n (TP p = 1) ###
BH.TP                                    ### n(TPaFDR) ###
BH.percent_FP <- BH.PFP*100                               ### %FP ###
Power                                 ###classical power
BH.FDRpower                              ### FDR power ###
BH.output <- data.frame(neutral_LRTs, BH.signif_P, BH.signif_q, BH.true_positive_pval_signif,
BH.true_positive_pval_1, BH.TP, BH.percent_FP, BH.Power,  BH.FDRpower)
