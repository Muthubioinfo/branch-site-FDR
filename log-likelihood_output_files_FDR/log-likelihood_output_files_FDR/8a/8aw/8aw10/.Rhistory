###Results after adjusting for BH-FDR ###
neutral_LRTs <- length(LRT[LRT == 0])                 ### LRT=0 ###
BH.signif_P <- length(p_halved[p_halved < 0.05])     ### n (p < 0.05) ###
BH.signif_q <- length(BH.q.val[BH.q.val < 0.05]) ### n (q < 0.05) ###
#True positive P-values - n (TP p < 0.05)
BH.true_positive_pval_signif <- print(sum(which(p_halved < 0.05) <= z))
BH.true_positive_pval_1 <- print(sum(which(p_halved == 1) <= z))     ### n (TP p = 1) ###
BH.TP                                    ### n(TPaFDR) ###
BH.percent_FP <- BH.PFP*100                               ### %FP ###
Power                                 ###classical power
BH.FDRpower                              ### FDR power ###
BH.output <- data.frame(neutral_LRTs, BH.signif_P, BH.signif_q, BH.true_positive_pval_signif,
BH.true_positive_pval_1, BH.TP, BH.percent_FP, Power,  BH.FDRpower)
colnames(BH.output) <- c("n(LRT=0)","n(P < 0.05)", "n(q < 0.05)",
"n(TP P < 0.05)","n(TP P = 1)","TP","percent_FP",
"classical_Power","FDR_power")
pval
##Case 2: ST-FDR
#Taking only the P-values < 1
pval_new <- pval[ which(pval < 1) , ,drop = FALSE] #Length of P-values less than 1
##Case 2: ST-FDR
#Taking only the P-values < 1
pval_new <- pval[pval < 1] #Length of P-values less than 1
pval_new
length(pval_new)
length(pval_new[pval_new < 0.05])
length(pval_new)
hist(pval_new)
##Case 2: ST-FDR
#Taking only the P-values < 1
pval_new <- pval[pval < 1] #Length of P-values less than 1
length(pval_new)
length(pval_new[pval_new < 0.05])
length(pval_new)
hist(pval_new)
###By default, pi0est used lambda = seq(0.05,0.95,0.05), and
####c("smoother","bootstrap") chooses the best method among the two methods
#Bootstrap method provides better estimate for pi0
#For example, when the smooth method is used, the pi0 estimate is around 80%, when
# The bootstrap method gives an estimate of 90%.
pi0_estimate <- qvalue::pi0est(pval_new,pi0.method="bootstrap")
#plotting pi0 estimate over lambda
plot(pi0_estimate$lambda, pi0_estimate$pi0.lambda)
###Proportion of true negatives over the P-values < 1 (under chi-square distribution)
pi0_TN <- pi0_estimate$pi0
pi0_TN
####Total number of P-values: 10000
####The total proportion is 1
pi1_P <- 1 - pi0_TN
pi1_P
#The total pi0 estimate is calculated by the sum of pi0 estimated from two halves of the
#mixture distribution
pi0_est_total <- ((length(pval[pval == 1]))/10000) + (pi0_TN * length(pval_new)/10000)
pi0_est_total
#Applying ST-FDR for P-values under mixture distribution at point mass 0 and chi-square
ST.q.val <- qvalue::qvalue(p_halved, fdr.level = 0.05, pfdr = TRUE,
pi0 = pi0_est_total)$qvalues
length(ST.q.val[ST.q.val < 0.05])
length(ST.q.val[ST.q.val > 0.05])
# Total Positives
ST.P <- length(which(ST.q.val < 0.05))
ST.TP <- sum(which(ST.q.val < 0.05) <= z) # [1] True positives identified after FDR
# Therefore, there are
ST.FP <- ST.P - ST.TP #False positives
#Proportion of false positives
ST.PFP <- ST.FP/ST.P  #which is very close to 0.05!
#CLASSICAL POWER
Power <- (print(sum(which(p_halved < 0.05) <= z))/z)*100
#FDR POWER
ST.FDRpower<- (ST.TP/z)*100
ST.FDRpower
###Results after adjusting for BH-FDR ###
ST.signif_P <- length(p_halved[p_halved < 0.05])     ### n (p < 0.05) ###
ST.signif_q <- length(ST.q.val[ST.q.val < 0.05]) ### n (q < 0.05) ###
#True positive P-values - n (TP p < 0.05)
ST.true_positive_pval_signif <- print(sum(which(p_halved < 0.05) <= z))
ST.true_positive_pval_1 <- print(sum(which(p_halved == 1) <= z))     ### n (TP p = 1) ###
ST.TP                                    ### n(TPaFDR) ###
ST.percent_FP <- ST.PFP*100                               ### %FP ###
Power                                 ###classical power
ST.FDRpower                              ### FDR power ###
ST.output <- data.frame(neutral_LRTs, ST.signif_P, ST.signif_q, ST.true_positive_pval_signif,
ST.true_positive_pval_1, ST.TP, ST.percent_FP, Power,  ST.FDRpower)
colnames(ST.output) <- c("n(LRT=0)","n(P < 0.05)", "n(q < 0.05)",
"n(TP P < 0.05)","n(TP P = 1)","ST.TP","ST.percent_FP",
"classical_Power","ST.FDR_power")
ST.output
BH.output
