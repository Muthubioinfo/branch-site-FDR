length(LRT[LRT > 0])
length(LRT[LRT == 0])
#Histogram of new LRT
hist(LRT, n=30, prob=TRUE, col="white",main=paste("Histogram of LRT"),xlab="LRT")
curve(dchisq(x, 1), add=TRUE, col="#00B050", lwd=2)
#P-values combined
pval <- pchisq(LRT, 1, lower.tail = FALSE)
#Creating a data frame of all P-values
row_pval <- paste("g",c(1:10000))
pval <- data.frame(pval, row.names = row_pval)$pval
length(pval[pval < 0.05]) #P-value significant
#Dividing P-values by 2 under the mixture distribution
p_halved <- ifelse(pval == 1, pval == pval, pval/2)  #Mixture distribution
#Histogram of new LRT
hist(p_halved, col="white",main=paste("Histogram of P-values"),xlab="P-values",ylab="Probability",ylim=c(0,5000), cex=2.5)
BH.psig <- which(p_halved < 0.05)
length(psig <- p_halved[which(p_halved < 0.05)]) #Significance of p-values
#######################################################
#CASE (1): BENJAMINI-HOCHBERG PROCEDURE
#Applying FDR control using p-adjust
BH.q.val <- qvalue::qvalue(p=p_halved)$qvalues
length(BH.q.val)
length(q.val[q.val < 0.05])  #Significance after applying FDR
