#####                Improved FDR          #####
########################################################################################################
#Simulating 10000 replicates under null hypothesis
rm(list=ls())
setwd("/Users/muthukumaranpanchaksaram/Documents/Proj20/paper/Results/Simresults/8sp/8a/8ap/8ap0.01")
#Null model: H0
ln0 <- read.table("rst1H0null") #rst1 - lnL0 values
ln0n <- ln0[[24]]
lnL0 <- as.vector(ln0n) #lnL0 values
length(lnL0)
#Alternate model: H1
ln1A <- read.table("rst1H0alt1") #rst1 - lnL1 for 1st iteration
ln1nA <- ln1A[[25]]
lnL1A <- as.vector(ln1nA) #lnL1 values for 1st iteration
length(lnL1A)
ln1B <- read.table("rst1H0alt2") #rst1 -  lnL1 for 2nd iteration
ln1nB <- ln1B[[25]]
lnL1B <- as.vector(ln1nB) #lnL1 values for 2nd iteration
length(lnL1B)
ln1C <- read.table("rst1H0alt3") #rst1 - lnL1 for 3rd iteration
ln1nC <- ln1C[[25]]
lnL1C <-as.vector(ln1nC) #lnL1 values for 3rd iteration
length(lnL1C)
lnL1 <- pmax(lnL0,lnL1A,lnL1B,lnL1C)
#LRT statistic for simulation under null hypothesis
LRTnull <- 2 * ((lnL1)-(lnL0))
length(LRTnull)
hist(LRTnull)
length(LRTnull[LRTnull > 0]) #LRT greater than 0
length(LRTnull[LRTnull == 0]) #LRT equal to 0######################
length(LRTnull[LRTnull < 0]) #LRT less than 0
#Histogram of LRT > 0
hist(LRTnull[LRTnull > 0], n=50, prob=TRUE)
curve(dchisq(x, 1), add=TRUE, col="red", lwd=2)
#P-values under null hypothesis
pnull <- pchisq(LRTnull, 1, lower.tail = FALSE)
pmixnull <- ifelse(pnull == 1, pnull == pnull, pnull/2)  #Mixture distribution
length(psnull <- pmixnull[which(pmixnull < 0.05)])
length(psnulln <- pmixnull[which(pmixnull > 0.05)])
#Applying FDR control using p-adjust for simulations under null hyp
qnull <- p.adjust(pmixnull, method = "fdr")
length(qnull)
length(qnullp <- qnull[qnull < 0.05]) ####################################
length(qnulln <- qnull[qnull > 0.05]) ####################################
####################################################
######Simulation 1000 replicates under H1###########
#Null model: H0
lna0 <- read.table("rst1H1null") #rst1 - lnL0 values
lna0n <- lna0[[24]]
lnaL0 <- as.vector(lna0n) #lnL0 values
length(lnaL0)
#Alternate model: H1
lna1A <- read.table("rst1H1alt1") #rst1 - lnL1 for 1st iteration
lna1nA <- lna1A[[25]]
lnaL1A <- as.vector(lna1nA) #lnL1 values for 1st iteration
length(lnaL1A)
lna1B <- read.table("rst1H1alt2") #rst1 -  lnL1 for 2nd iteration
lna1nB <- lna1B[[25]]
lnaL1B <- as.vector(lna1nB) #lnL1 values for 2nd iteration
length(lnaL1B)
lna1C <- read.table("rst1H1alt3") #rst1 - lnL1 for 3rd iteration
lna1nC <- lna1C[[25]]
lnaL1C <-as.vector(lna1nC) #lnL1 values for 3rd iteration
length(lnaL1C)
lnaL1 <- pmax(lnaL0,lnaL1A,lnaL1B,lnaL1C)
#LRT statistic for simulation under alternate hypothesis
LRTalt <- 2 * ((lnaL1)-(lnaL0))
length(LRTalt)
hist(LRTalt)
LRTaltp<- LRTalt[LRTalt > 0] #LRT greater than 0
length(LRTaltp)
LRTalt0<- LRTalt[LRTalt == 0] #LRT equal to 0
length(LRTalt0)
LRTaltn <- LRTalt[LRTalt < 0] #LRT less than 0
length(LRTaltn)
#Histogram LRTalt
hist(LRTalt[LRTalt > 0], n=25, prob=TRUE)
#P-values for simulations under alternate hypothesis
palt <- pchisq(LRTalt, 1, lower.tail = FALSE)
pmixalt <- ifelse(palt == 1, palt == palt, palt/2)  #Mixture distribution
length(psalt <- pmixalt[pmixalt < 0.05])
length(psaltn <- pmixalt[pmixalt > 0.05])
#Applying FDR control using p-adjust for simulations under null hyp
qalt <- p.adjust(pmixalt, method = "fdr")
length(qalt)
length(qaltp <- qalt[qalt < 0.05])
length(qaltn <- qalt[qalt > 0.05])
####################################################################################################
#Combining the first 1000 replicates simulated under alternate hypothesis with the subsequent 9000
#simulated under null hypothesis####################################################################
#Removing the first 1000 replicates from the vector LRTnull to get LRT9000
LRT9000 <- LRTnull[-(1:1000)] #LRTnull is the LRT vector simulated for 10000 simulations under null
all.equal(LRTnull[1001:10000], LRT9000) #To verify the new vector
#Adding the 1000 replicates from LRTalt combining to new LRT
LRT <- c(LRTalt, LRT9000) #LRTalt is the LRT calculated for 1000 simulations under alternate hyp
all.equal(LRT[1:1000], LRTalt) #To verify the new LRT
length(LRT[LRT > 0])
length(LRT[LRT == 0])
#Histogram of new LRT
hist(LRT[LRT > 0], n=25, prob=TRUE)
curve(dchisq(x, 1), add=TRUE, col="red", lwd=2)
#P-values combined
pval <- pchisq(LRT, 1, lower.tail = FALSE)
pmix <- ifelse(pval == 1, pval == pval, pval/2)  #Mixture distribution
length(psig <- pmix[which(pmix < 0.05)]) #Significance of p-values
length(psign <- pmix[which(pmix > 0.05)])
#Applying FDR control using p-adjust
q.val <- p.adjust(pmix, method = "fdr")
length(q.val)
length(q.valp <- q.val[q.val < 0.05])  #Significance after applying FDR
length(q.valn <- q.val[q.val > 0.05])
#FDR
P <- sum(q.val < 0.05) # [1] Total Positives
P
# However, only simulations 1 to 1,000 are true positives/considered under positive selection, thus:
which(q.val < 0.05)
TP <- sum(which(q.val < 0.05) <= 1e3) # [1] True positives identified after FDR
TP
# Therefore, there are
FP <- P - TP #False positives
FP
#Proportion of false positives
PFP <- FP/P  #which is very close to 0.05!
PFP
FDRpower<- (TP/1000)*100
FDRpower
#
###Compiled results###
###Under null####
length(LRTnull[LRTnull == 0])                 ###LRT=0###
length(psnull <- pmixnull[pmixnull < 0.025])  ### n (p < 0.025) ###
length(psnull <- pmixnull[pmixnull < 0.05])   ### n (p < 0.05) ###
length(qnullp <- qnull[qnull < 0.05])         ### n (q < 0.05) ###
###Null and alternate###
length(LRT[LRT == 0])                 ### LRT=0 ###
length(psig <- pmix[pmix < 0.025])    ### n (p < 0.025) ###
length(psig <- pmix[pmix < 0.05])     ### n (p < 0.05) ###
length(q.valp <- q.val[q.val < 0.05]) ### n (q < 0.05) ###
print(sum(which(pmix < 0.05) <= 1e3)) ### n (TP p < 0.05) ###
TP                                    ### n(TPaFDR) ###
PFP*100                               ### %FP ###
FDRpower                              ### FDR power ###
#Checking if it is right or not
row_pval <- paste("g",c(1:10000))
dat_frame_pval <- data.frame(pval,row.names = row_pval)
length(dat_frame_pval$pval[dat_frame_pval$pval < 0.05])
dat_frame_pval_lessthan1 <- dat_frame_pval[ which(dat_frame_pval$pval < 1) , ,drop = FALSE]
length(dat_frame_pval_lessthan1$pval[dat_frame_pval_lessthan1$pval < 0.05])
pval_new <- dat_frame_pval_lessthan1$pval
length(pval_new)
hist(pval_new)
pi0_estimate_case2 <- qvalue::pi0est(pval_new, lambda = seq(0.05, 0.95, 0.05), pi0.method = "smoother")
###Proportion of true negatives over the P-values < 1 (under chi distribution)
pi0_TN <- pi0_estimate_case2$pi0
pi0_TN
####Total number of P-values: 10000
####The total proportion is 1
pi1_P <- 1 - pi0_TN
pi1_P
pi0_est_total_case2 <- (round(pi0_estimate_case2$pi0*length(pval_new))/10000)
ST_q.val_case2 <- qvalue::qvalue(pmix, fdr.level = 0.05, lambda = seq(0.05, 0.95, 0.05), pi0 = pi0_est_total_case2)
length(ST_q.val_case2$qvalues[ST_q.val_case2$qvalues < 0.05])
length(ST_q.val_case2$qvalues[ST_q.val_case2$qvalues > 0.05])
dat_frame_qval <- data.frame(ST_q.val_case2$qvalues,row.names = row_pval)
hist(dat_frame_qval$ST_q.val_case2.qvalues)
length(dat_frame_qval$ST_q.val_case2.qvalues)
dat_frame_qval_rej <- dat_frame_qval[ which(dat_frame_qval$ST_q.val_case2.qvalues < 0.05), , drop = FALSE ] #Significance after applying FDR
length(dat_frame_qval_rej$ST_q.val_case2.qvalues)
dat_frame_qval_acpt <- dat_frame_qval[ which(dat_frame_qval$ST_q.val_case2.qvalues > 0.05), , drop = FALSE ] #Significance after applying FDR
length(dat_frame_qval_acpt$ST_q.val_case2.qvalues)
#FDR
ST_P_case2 <- length(dat_frame_qval_rej$ST_q.val_case2.qvalues) # [1] Total Positives
ST_P_case2
# However, only simulations 1 to 1,000 are true positives/considered under positive selection, thus:
row_TP_case2 <- paste("g",c(1:1000))
ST_TP_frame_case2 <- dat_frame_qval_rej[rownames(dat_frame_qval_rej) %in% row_TP_case2, , drop = FALSE]
ST_TP_case2 <- length(ST_TP_frame_case2$ST_q.val_case2.qvalues)
ST_TP_case2
# Therefore, there are
ST_FP_case2 <- ST_P_case2 - ST_TP_case2 #False positives
ST_FP_case2
#Proportion of false positives
ST_PFP_case2 <- ST_FP_case2/ST_P_case2  #which is very close to 0.05!
ST_PFP_case2
ST_FDRpower_case2<- (ST_TP_case2/1000)*100
ST_FDRpower_case2
hist(ST_q.val_case2)
