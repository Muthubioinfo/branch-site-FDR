##################################################
#pnull
row_pnull <- paste("g",c(1:10000))
dat_frame_pnull <- data.frame(pnull,row.names = row_pnull)
length(dat_frame_pnull$pnull[dat_frame_pnull$pnull < 0.05])
dat_frame_pnull_lessthan1 <- dat_frame_pnull[ which(dat_frame_pnull$pnull < 1) , ,drop = FALSE]
length(dat_frame_pnull_lessthan1$pnull[dat_frame_pnull_lessthan1$pnull < 0.05])
pnull_new <- dat_frame_pnull_lessthan1$pnull
length(pnull_new)
hist(pnull_new)
pi0_estimate_case2 <- qvalue::pi0est(pnull_new, lambda = seq(0.05, 0.95, 0.05), pi0.method = "smoother")
###Proportion of true negatives over the P-values < 1 (under chi distribution)
pi0_TN <- pi0_estimate_case2$pi0
pi0_TN
####Total number of P-values: 10000
####The total proportion is 1
pi1_P <- 1 - pi0_TN
pi1_P
pi0_est_total_case2 <- (round(pi0_estimate_case2$pi0*length(pnull_new))/10000)
ST_q.val_case2 <- qvalue::qvalue(pnull, fdr.level = 0.05, lambda = seq(0.05, 0.95, 0.05), pi0 = pi0_est_total_case2)
length(ST_q.val_case2$qvalues[ST_q.val_case2$qvalues < 0.05])
length(ST_q.val_case2$qvalues[ST_q.val_case2$qvalues > 0.05])
dat_frame_qval <- data.frame(ST_q.val_case2$qvalues,row.names = row_pnull)
hist(dat_frame_qval$ST_q.val_case2.qvalues)
length(dat_frame_qval$ST_q.val_case2.qvalues)
dat_frame_qval_rej <- dat_frame_qval[ which(dat_frame_qval$ST_q.val_case2.qvalues < 0.05), , drop = FALSE ] #Significance after applying FDR
length(dat_frame_qval_rej$ST_q.val_case2.qvalues)
dat_frame_qval_acpt <- dat_frame_qval[ which(dat_frame_qval$ST_q.val_case2.qvalues > 0.05), , drop = FALSE ] #Significance after applying FDR
length(dat_frame_qval_acpt$ST_q.val_case2.qvalues)
#FDR
ST_P_case2 <- length(dat_frame_qval_rej$ST_q.val_case2.qvalues) # [1] Total Positives
ST_P_case2
# However, only simulations 1 to 1,000 are true positives/considered under positive selection, thus:
row_TP_case2 <- paste("g",c(1:1000))
ST_TP_frame_case2 <- dat_frame_qval_rej[rownames(dat_frame_qval_rej) %in% row_TP_case2, , drop = FALSE]
ST_TP_case2 <- length(ST_TP_frame_case2$ST_q.val_case2.qvalues)
ST_TP_case2
# Therefore, there are
ST_FP_case2 <- ST_P_case2 - ST_TP_case2 #False positives
ST_FP_case2
#Proportion of false positives
ST_PFP_case2 <- ST_FP_case2/ST_P_case2  #which is very close to 0.05!
ST_PFP_case2
ST_FDRpower_case2<- (ST_TP_case2/1000)*100
ST_FDRpower_case2
hist(ST_q.val_case2)
#############
length(which(pnull == 1))
length(which(pnull < 1))
pi0_TN
pi1_P
pi0_est_total_case2
length(ST_q.val_case2$qvalues[ST_q.val_case2$qvalues < 0.05])
ST_TP_case2
